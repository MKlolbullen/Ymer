<?xml version="1.0" encoding="utf-8"?>
<!-- The web view loads the bundled app from the app's own relay on the loopback
     interface (desktop/src-tauri/relay), which is plain http. Everything else must
     use https from the web view; the relay itself may reach an http server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
