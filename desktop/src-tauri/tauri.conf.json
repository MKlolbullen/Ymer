{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ymer Desktop",
  "version": "0.1.0-beta.1",
  "identifier": "app.ymer.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ymer",
        "width": 1280,
        "height": 820,
        "minWidth": 400,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Ymer desktop client",
    "longDescription": "Opens your Ymer server (collaborative documents, databases, mind maps and the Factory) in its own window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "0.1.201"
      }
    }
  },
  "mainBinaryName": "ymer-desktop"
}
