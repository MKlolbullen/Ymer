{
  "uid": "ymer-overview",
  "title": "Ymer overview",
  "tags": [
    "ymer"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
