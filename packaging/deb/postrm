#!/bin/sh
set -e
if [ "$1" = purge ]; then
  rm -f /etc/ymer/ymer.env /etc/ymer/alertmanager.yml
  rmdir /etc/ymer 2>/dev/null || true
  echo "Ymer's data is kept in Docker volumes, locked with the passwords that were just removed."
  echo "Before installing Ymer again, delete it: docker volume rm ymer_postgres-data ymer_redis-data ymer_minio-data"
  echo "Backups in /var/backups/ymer are kept; they hold your data, so delete them yourself if you mean to."
fi
if [ -d /run/systemd/system ]; then systemctl daemon-reload || true; fi
exit 0
