# Copy to .env and adjust. Docker Compose and the backend both read this file.

# --- Postgres (pgvector) ---
POSTGRES_USER=ymer
POSTGRES_PASSWORD=ymer
POSTGRES_DB=ymer
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=ymer
MINIO_ROOT_PASSWORD=ymer-dev-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Community MinIO build (official minio/minio left Docker Hub); see DEVELOPMENT.md.
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z

# --- Backend (Flask) ---
# All backend settings use the YMER_ prefix; see backend/ymer/config.py.
YMER_ENV=development
YMER_SECRET_KEY=change-me
YMER_DATABASE_URL=postgresql+psycopg://ymer:ymer@localhost:5432/ymer
YMER_TEST_DATABASE_URL=postgresql+psycopg://ymer:ymer@localhost:5432/ymer_test
YMER_REDIS_URL=redis://localhost:6379/0
YMER_S3_ENDPOINT_URL=http://localhost:9000
YMER_S3_ACCESS_KEY=ymer
YMER_S3_SECRET_KEY=ymer-dev-secret
YMER_S3_BUCKET=ymer
YMER_S3_REGION=us-east-1
YMER_CORS_ORIGINS=http://localhost:5173
# Shared secret between Flask and the collab service (use 32+ random characters in production).
YMER_COLLAB_SECRET=change-me-collab

# --- Collab service (Hocuspocus, collab/) ---
YMER_COLLAB_PORT=1234
YMER_COLLAB_BACKEND_URL=http://localhost:5000
