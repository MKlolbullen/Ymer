# Copy to .env and adjust. Docker Compose and the backend both read this file.

# --- Postgres (pgvector) ---
POSTGRES_USER=ymer
POSTGRES_PASSWORD=ymer
POSTGRES_DB=ymer
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=ymer
MINIO_ROOT_PASSWORD=ymer-dev-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Community MinIO build (official minio/minio left Docker Hub); see DEVELOPMENT.md.
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z

# --- Backend (Flask) ---
# All backend settings use the YMER_ prefix; see backend/ymer/config.py.
YMER_ENV=development
YMER_SECRET_KEY=change-me
YMER_DATABASE_URL=postgresql+psycopg://ymer:ymer@localhost:5432/ymer
YMER_TEST_DATABASE_URL=postgresql+psycopg://ymer:ymer@localhost:5432/ymer_test
YMER_REDIS_URL=redis://localhost:6379/0
YMER_S3_ENDPOINT_URL=http://localhost:9000
YMER_S3_ACCESS_KEY=ymer
YMER_S3_SECRET_KEY=ymer-dev-secret
YMER_S3_BUCKET=ymer
YMER_S3_REGION=us-east-1
YMER_CORS_ORIGINS=http://localhost:5173
# Shared secret between Flask and the collab service (use 32+ random characters in production).
YMER_COLLAB_SECRET=change-me-collab

# --- Collab service (Hocuspocus, collab/) ---
YMER_COLLAB_PORT=1234
YMER_COLLAB_BACKEND_URL=http://localhost:5000

# --- AI layer (backend/ymer/ai) ---
# fake = offline demo stand-in (no key, no network; the UI labels its output as a demo)
# anthropic = Claude (set ANTHROPIC_API_KEY); openai = any OpenAI-compatible server
# (Ollama, vLLM, LM Studio) at YMER_AI_BASE_URL; off = hide AI features.
# Encrypt personal provider keys with a stable random secret (generate with openssl rand -hex 32).
# If omitted, Ymer derives the encryption key from YMER_SECRET_KEY (minimum 32 characters).
# YMER_AI_CREDENTIAL_SECRET=
YMER_AI_PROVIDER=fake
# Model for anthropic/openai. Default: Claude Opus 5.5. For Ollama e.g. llama3.3.
YMER_AI_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
# YMER_AI_BASE_URL=http://localhost:11434/v1
# Embeddings for semantic search: fake (hashed words) or openai (e.g. Ollama nomic-embed-text).
YMER_AI_EMBEDDING_PROVIDER=fake
YMER_AI_EMBEDDING_MODEL=hash-256
# Index pages in the request that changed them (dev). Otherwise run `make ai-worker`.
YMER_AI_INDEX_INLINE=true

# --- Factory builds (backend/ymer/factory) ---
# Where the code the AI writes runs: fake = nothing runs, files are only checked (dev);
# docker = one locked-down container per command, no network (run `make factory-images`);
# off = builds turned off. Builds also need a model with tool use (anthropic, or fake).
YMER_FACTORY_SANDBOX=fake
# Run builds in a thread of the web process (dev). Otherwise run `make factory-worker`.
YMER_FACTORY_RUN_INLINE=true
# Budgets per build: model steps in total and per task, and tokens.
# YMER_FACTORY_MAX_STEPS=300
# YMER_FACTORY_TASK_STEPS=30
# YMER_FACTORY_MAX_TOKENS=3000000
# Monthly token limit for all Factory builds in a workspace (0: no limit). Owners can
# set their own limit on the factory page.
# YMER_FACTORY_WORKSPACE_MONTHLY_TOKENS=20000000
# Delivery: releases are pushed over HTTPS to these hosts only (tokens are never stored).
# YMER_FACTORY_GIT_HOSTS=github.com,gitlab.com,bitbucket.org,codeberg.org
# CA bundle for a self-hosted Git server with a private certificate:
# YMER_FACTORY_GIT_CA_BUNDLE=/etc/ssl/private-ca.pem
# YMER_FACTORY_PREVIEW_MINUTES=60

# --- Sessions, rate limits and the audit log -----------------------------------------
# Login cookies are Secure (HTTPS only) in production; force either way here.
# YMER_COOKIE_SECURE=true
# Only when the API and the app are on different subdomains of one site:
# YMER_COOKIE_DOMAIN=.example.com
# Number of reverse proxies in front of Flask (for the real client address).
# YMER_TRUSTED_PROXIES=1
# YMER_RATE_LIMIT_ENABLED=true
# YMER_RATE_LIMIT_API=600
# YMER_RATE_LIMIT_LOGIN=20
# YMER_RATE_LIMIT_LOGIN_FAILURES=10
# YMER_RATE_LIMIT_REGISTER=10
# YMER_RATE_LIMIT_UPLOADS=60
# YMER_RATE_LIMIT_GIT_PUSH=20
# YMER_AUDIT_RETENTION_DAYS=365
# Seconds an upload or download to S3 may wait.
# YMER_S3_TIMEOUT=30
